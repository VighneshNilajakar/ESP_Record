# Build-time configuration for the root sketch.
#
#   copy .env.example .env
#   edit .env
#   python tools/gen_config.py
#   arduino-cli compile --fqbn esp32:esp32:esp32cam .
#
# The values below are the reference-board defaults. Lines that are commented
# out (or missing) fall back to the same defaults compiled into the sketch.
# .env and the generated config.h are gitignored; commit changes here instead.

# ---- Capture -------------------------------------------------------------
RECORD_SECONDS=20
SAMPLE_RATE_HZ=16000
I2S_SLOT=right
# 16 is the unity 24-to-16 reduction; 15 adds +6 dB and is the measured
# reference default. 14 reached 31863/32768 on a loud take.
PCM_RIGHT_SHIFT=15

# ---- GPIO assignments (AI-Thinker ESP32-CAM + INMP441) -------------------
# GPIO14/15 are shared with SD_MMC, GPIO12 is a strapping pin and SD DAT2,
# and GPIO4 is both the flash LED and SD D1. Do not reuse a pin.
PIN_BCLK=14
PIN_WS=15
PIN_DOUT=12
PIN_LED=4
LED_ACTIVE_HIGH=1

# ---- Storage -------------------------------------------------------------
# 0 uses the core default (~20 MHz). 4000 is what stopped this board from
# browning out during a save; see docs/support-matrix.md.
SD_FREQUENCY_KHZ=4000
SD_MOUNT_POINT=/sdcard

# ---- Serial --------------------------------------------------------------
SERIAL_BAUD=115200
